{
  "name": "research-operating-system",
  "rosVersion": "1.0.0",
  "repSpecificationVersion": "2.0",
  "bootstrap": "BOOTSTRAP.md",
  "canonicalRoots": {
    "journals": "research/journals",
    "packages": "research/packages",
    "theories": "research/theories",
    "evidence": "research/evidence"
  },
  "registries": "registries",
  "templates": "templates",
  "generated": "generated",
  "repository": {
    "id": "repository-operating-system",
    "type": "tooling",
    "identity": {
      "provider": "github",
      "repositoryId": "github:1309152643",
      "repository": "kemiller2002/praxis"
    }
  },
  "workProtocol": {
    "version": "1.0.0",
    "enforceAttribution": true,
    "semanticMapping": {
      "ready": "ready",
      "active": "active",
      "blocked": "blocked",
      "complete": "complete"
    },
    "completionEvidence": {
      "default": [
        "implementation",
        "tests"
      ],
      "research": [
        "research-record"
      ],
      "mechanical": []
    },
    "meaningfulPaths": [
      "**"
    ],
    "ignoredPaths": [
      ".git/**",
      ".ros/context/**",
      ".ros/events/**",
      ".ros/work/**",
      ".ros/telemetry/**",
      ".ros/executions/**",
      ".ros/locks/**",
      ".ros/remote/**",
      ".ros/planning/**",
      ".praxis-inbox/**",
      "registries/**",
      ".echelon/**"
    ],
    "continuity": {
      "requireDurableCheckpoint": true
    },
    "upstreamSync": {
      "enabled": true,
      "remote": "origin",
      "branch": "main",
      "maxAgeMinutes": 30
    }
  },
  "implementationPolicy": {
    "version": "1.0.0",
    "prohibitNodeArtifacts": true,
    "prohibitPythonAutomation": true,
    "exceptions": [
      {
        "path": "research/experiments/EX-ROS-2026-A021-harness/session_metrics.py",
        "decision": "DF-ROS-2026-A054"
      },
      {
        "path": "research/experiments/EX-ROS-2026-A021-evaluation-kit/prepare-blind-bundle.sh",
        "decision": "DF-ROS-2026-A054"
      },
      {
        "path": "research/experiments/EX-ROS-2026-A022-target-gate/inventory.py",
        "decision": "DF-ROS-2026-A054"
      },
      {
        "path": "research/experiments/EX-ROS-2026-A022-target-gate/signal/signal_structure.py",
        "decision": "DF-ROS-2026-A054"
      },
      {
        "path": "scripts/praxis-bootstrap.sh",
        "decision": "DF-ROS-2026-A054"
      },
      {
        "path": "scripts/praxis-remote-persist.sh",
        "decision": "DF-ROS-2026-A054"
      },
      {
        "path": "scripts/praxis-remote-inbox.sh",
        "decision": "DF-ROS-2026-A054"
      },
      {
        "path": ".github/actions/praxis-remote/action.yml",
        "decision": "DF-ROS-2026-A054"
      },
      {
        "path": ".github/workflows/praxis-remote.yml",
        "decision": "DF-ROS-2026-A054"
      }
    ]
  },
  "provenance": {
    "version": "1.0.0",
    "enforce": true,
    "requiredFrom": "2026-09-25",
    "requireOriginator": [
      "RQ"
    ]
  },
  "telemetry": {
    "version": "1.0.0",
    "enabled": true,
    "requireFinalization": true,
    "executionRoot": ".ros/telemetry/executions",
    "metricRegistry": "telemetry/metrics.json",
    "allowRawTelemetry": true,
    "maxRawPayloadBytes": 262144,
    "maxRawSnapshotsPerExecution": 256,
    "maxRawBytesPerExecution": 8388608,
    "maxCapabilityHistoryEntries": 64
  },
  "remote": {
    "capabilities": [
      "read",
      "mutate",
      "complete"
    ]
  }
}
