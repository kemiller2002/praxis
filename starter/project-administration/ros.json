{
  "name": "{{PROJECT_SLUG}}",
  "project": "{{PROJECT_NAME}}",
  "rosVersion": "{{ROS_VERSION}}",
  "repSpecificationVersion": "2.0",
  "profile": "project-administration",
  "bootstrap": "BOOTSTRAP.md",
  "canonicalRoots": {
    "journals": "research/journals",
    "packages": "research/packages",
    "theories": "research/theories",
    "evidence": "research/evidence"
  },
  "registries": "registries",
  "templates": "templates",
  "generated": "generated",
  "repository": {"id": "{{PROJECT_SLUG}}", "type": "hub"},
  "workProtocol": {
    "version": "1.0.0",
    "enforceAttribution": true,
    "semanticMapping": {"ready": "ready", "active": "active", "blocked": "blocked", "complete": "complete"},
    "completionEvidence": {"default": ["implementation", "tests"], "mechanical": []},
    "meaningfulPaths": ["**"],
    "ignoredPaths": [".git/**", ".ros/context/**", ".ros/events/**", ".ros/work/**", ".ros/telemetry/**", ".ros/hub/**", "registries/**"]
  },
  "telemetry": {
    "version": "1.0.0",
    "enabled": true,
    "requireFinalization": true,
    "executionRoot": ".ros/telemetry/executions",
    "metricRegistry": "telemetry/metrics.json",
    "allowRawTelemetry": true,
    "maxRawPayloadBytes": 262144
  }
}
