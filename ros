#!/usr/bin/env sh
# Runs this source checkout's F# CLI (DF-ROS-2026-A030). The only
# prerequisite is the .NET SDK that builds it; see DF-ROS-2026-A041.
set -eu

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
dll="${ROS_FS_DLL_PATH_OVERRIDE:-$repo_root/src/Ros.Cli/bin/Release/net10.0/ros-fs.dll}"

if [ ! -f "$dll" ]; then
  printf '%s\n' "./ros needs the F# CLI built first. Run 'dotnet build Ros.slnx --configuration Release', then retry." "Missing: $dll" >&2
  exit 1
fi

command -v dotnet >/dev/null 2>&1 || { printf '%s\n' "./ros: dotnet is not on PATH; install the .NET 10 SDK." >&2; exit 1; }

exec dotnet "$dll" "$@"
