<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Repository root, used to locate the scaffold this CLI embeds. -->
  <PropertyGroup>
    <RosRepositoryRoot>$(MSBuildThisFileDirectory)</RosRepositoryRoot>
  </PropertyGroup>

  <!-- package.json is the single authoritative version source for the F#
       CLI and every channel it ships in (native bundles, the .NET global
       tool; DF-ROS-2026-A044), so the CLI's reported version can never
       drift from the released version. The CLI reads it back at
       runtime from its own AssemblyInformationalVersion. -->
  <PropertyGroup>
    <RosPackageVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)package.json')), '"version"\s*:\s*"([^"]+)"').Groups.get_Item(1).Value)</RosPackageVersion>
    <Version>$(RosPackageVersion)</Version>
    <InformationalVersion>$(RosPackageVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
