<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ordo's execution semantics, consumed as the pinned release artifact
         (vendor/nuget/ordo-core.lock; ORDO-CORE-PACKAGE, PRX-ARCH-001). Pure:
         no I/O, no provider SDK. -->
    <PackageReference Include="EchelonFoundry.Ordo.Core" Version="1.5.0" />
  </ItemGroup>
