# Operating-system files
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# .NET / F# build output (src/tests trees only -- the repo-root bin/ holds
# tracked npm CLI entrypoints, e.g. bin/ros-bootstrap.mjs and bin/ros-fs.mjs)
src/**/bin/
src/**/obj/
tests/**/bin/
tests/**/obj/

# Compiled web UI (build with `npm run build:web`; source of truth is web/app.ts)
web/app.js
web/app.js.map
web-hub/app.js
web-hub/app.js.map

# Written by publish.yml into the npm tarball only; never committed to source
lib/stable-ros-version.json

# Generated transient work
.ros/locks/
work/staging/*
work/review/*
logs/*

# Preserve directory markers and documentation
!work/staging/.gitkeep
!work/review/.gitkeep
!logs/.gitkeep

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
