# Operating-system files
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node: kept as a guard. This repository owns no Node code (DF-ROS-2026-A041),
# but a stray install must never be committed.
node_modules/

# .NET / F# build output (src/tests trees only -- the repo-root bin/ holds
# tracked native launcher scripts, e.g. bin/praxis-native.sh and bin/echelon.sh)
src/**/bin/
src/**/obj/
tests/**/bin/
tests/**/obj/
site-tools/bin/
site-tools/obj/


# Generated transient work
.ros/locks/
work/staging/*
work/review/*
logs/*

# Preserve directory markers and documentation
!work/staging/.gitkeep
!work/review/.gitkeep
!logs/.gitkeep

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
_site/
dist/
