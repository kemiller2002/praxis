{
  "name": "@echelon-foundry/repository-operating-system",
  "version": "1.2.1",
  "description": "Self-contained Repository Operating System bootstrap for greenfield research and engineering projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemiller2002/repository-operating-system.git"
  },
  "homepage": "https://github.com/kemiller2002/repository-operating-system#readme",
  "bugs": {
    "url": "https://github.com/kemiller2002/repository-operating-system/issues"
  },
  "type": "module",
  "bin": {
    "ros-bootstrap": "./bin/ros-bootstrap.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "starter/",
    "AGENTS.md",
    "BOOTSTRAP.md",
    ".editorconfig",
    ".gitattributes",
    ".gitignore",
    "LICENSE",
    "docs/00-governance/",
    "docs/work-protocol.md",
    "docs/work-adapter-contract.md",
    "docs/work-backlog-guide.md",
    "docs/web-interface.md",
    "docs/project-administration-hub.md",
    "docs/development-telemetry.md",
    "docs/migrations/",
    "framework/",
    "schemas/",
    "telemetry/",
    "templates/",
    "tools/ros_cli.mjs",
    "tools/ros_telemetry.mjs",
    "tools/ros_persistence.mjs",
    "tools/http_body.mjs",
    "tools/ros_server.mjs",
    "tools/ros_hub_cli.mjs",
    "tools/ros_hub_server.mjs",
    "web/",
    "web-hub/",
    "CLAUDE.md",
    "GEMINI.md",
    ".github/copilot-instructions.md",
    "README.md",
    "PACKAGE-USAGE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/npm-bootstrap.test.mjs tests/work-protocol.test.mjs tests/telemetry.test.mjs tests/ros-server.test.mjs tests/ros-hub.test.mjs tests/artifact-compatibility.test.mjs && python3 -m unittest discover -s tests -v",
    "build:web": "tsc -p web/tsconfig.json",
    "build:hub": "tsc -p web-hub/tsconfig.json",
    "web": "npm run build:web && node tools/ros_server.mjs",
    "hub": "npm run build:hub && node tools/ros_hub_server.mjs",
    "pack:inspect": "npm pack --dry-run",
    "release:check": "npm test && npm pack --dry-run && ./ros registry check && ./ros validate",
    "prepack": "npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "keywords": [
    "repository",
    "operating-system",
    "research",
    "engineering",
    "bootstrap",
    "npx"
  ]
}
