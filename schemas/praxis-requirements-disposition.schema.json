{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository-operating-system.local/schemas/praxis-requirements-disposition.schema.json",
  "title": "praxis.requirements-disposition/1",
  "description": "A derived requirements package's disposition of every source requirement in a praxis.requirements-baseline/1 baseline, with the mapping of each source obligation to the derived criteria (REQUIREMENT-ID#CRITERION-ID) that carry it (REQ-PRES-001). Approvals are referenced by decisionId, never embedded. See docs/requirements-preservation.md.",
  "type": "object",
  "required": ["schema", "baseline", "package", "dispositions"],
  "properties": {
    "schema": { "const": "praxis.requirements-disposition/1" },
    "baseline": {
      "type": "object",
      "required": ["id", "commit", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the baseline file's bytes the package was reconciled against (REQ-PRES-001-R1). The gate refuses a mismatch and blocks when it is absent." }
      },
      "additionalProperties": false
    },
    "package": { "type": "string", "minLength": 1 },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "disposition"],
        "properties": {
          "requirement": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["preserved", "strengthened", "excluded-with-approval", "superseded", "not-applicable"] },
          "mappings": { "type": "array", "items": { "$ref": "#/$defs/mapping" } },
          "rationale": { "type": ["string", "null"] },
          "approval": { "type": ["string", "null"], "description": "decisionId of an approval record; required for excluded-with-approval and superseded." },
          "replacement": { "type": "array", "items": { "$ref": "#/$defs/criterionRef" }, "description": "Required for superseded." },
          "justification": { "type": ["string", "null"], "description": "Required for not-applicable." }
        },
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirements", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requirements": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "description": { "type": "string", "minLength": 1 },
          "decision": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "criterionRef": { "type": "string", "pattern": "^[^#]+#[^#]+$" },
    "mapping": {
      "type": "object",
      "required": ["obligation"],
      "properties": {
        "obligation": { "type": "string", "minLength": 1 },
        "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterionRef" } },
        "review": {
          "type": "object",
          "required": ["reviewer", "date", "basis"],
          "description": "A human equivalence review; honoured only for an obligation without tokens. Never generated by Praxis.",
          "properties": {
            "reviewer": { "type": "string" },
            "date": { "type": "string", "description": "yyyy-MM-dd" },
            "basis": { "type": "string" }
          },
          "additionalProperties": false
        },
        "exclusion": {
          "type": "object",
          "required": ["approval", "rationale"],
          "properties": {
            "approval": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [ { "required": ["criteria"] }, { "required": ["exclusion"] } ],
      "additionalProperties": false
    }
  }
}
