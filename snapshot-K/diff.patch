+              Assert.empty (validateFindings root)
+              let shown = PraxisCli.run root None [ "work"; "group"; "show"; "GROUP-FIXTURE-001" ]
+              Assert.isTrue (not (shown.Output.Contains "TASK-B")) shown.Output
