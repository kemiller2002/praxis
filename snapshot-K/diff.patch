+          t "checkpoint usage errors exit 2" (fun () ->
+              let root = fixture ()
+              declare root [ "--id"; "GROUP-FIXTURE-001"; "--member"; "TASK-A"; "--member"; "TASK-B" ] |> PraxisCli.ok |> ignore
+              let stored = File.ReadAllText(storePath root)
