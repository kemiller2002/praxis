{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/echelon-foundations-v1.schema.json",
  "title": "Echelon Application Foundations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "application": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aegis": { "$ref": "#/$defs/capability" },
        "forma": { "$ref": "#/$defs/capability" },
        "folio": { "$ref": "#/$defs/capability" },
        "limen": { "$ref": "#/$defs/capability" },
        "ordo": { "$ref": "#/$defs/capability" },
        "praxis": { "$ref": "#/$defs/capability" }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "version": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "boundaryManifest": { "type": "string", "minLength": 1 }
      }
    }
  }
}
