{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://echelonfoundry.com/praxis/envelope/v1.schema.json",
  "title":"Praxis fallback reconciliation envelope",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","transactionId","workItem","branch","baseCommit","agent","timeline","requests"],
  "properties":{
    "schemaVersion":{"const":"1.0"},
    "transactionId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "workItem":{"type":"string","minLength":1},
    "branch":{"type":"string","minLength":1},
    "baseCommit":{"type":"string","pattern":"^[0-9a-fA-F]{40}$"},
    "praxisInstanceId":{"type":["string","null"],"minLength":1,"description":"Locally authoritative Praxis instance identity when available; omission means unavailable, not an invented value."},
    "agent":{"type":"object","additionalProperties":true,"required":["kind","id"],"properties":{"kind":{"type":"string","minLength":1},"id":{"type":"string","minLength":1},"provider":{"type":["string","null"]},"model":{"type":["string","null"]},"runtime":{"type":["string","null"]}}},
    "execution":{
      "type":"object",
      "additionalProperties":true,
      "required":["executionId","startedAt","steps"],
      "properties":{
        "executionId":{"type":"string","pattern":"^EXE-[A-Za-z0-9._-]+$"},
        "startedAt":{"type":"string","format":"date-time"},
        "steps":{"type":"array","items":{"$ref":"#/$defs/step"}}
      }
    },
    "timeline":{"type":"array","items":{"type":"object","additionalProperties":true,"required":["sequence","timestamp","action"],"properties":{"sequence":{"type":"integer","minimum":1},"timestamp":{"type":"string","format":"date-time"},"action":{"type":"string","minLength":1}}}},
    "requests":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":true,"required":["type"],"properties":{"type":{"enum":["work.start","work.begin","work.block","work.resume","work.complete"]},"occurredAt":{"type":"string","format":"date-time"},"workType":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1},"conclusion":{"type":"string"},"evidence":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["type","path"],"properties":{"type":{"type":"string","minLength":1},"path":{"type":"string","minLength":1}}}}}}},
    "evidence":{"type":"array","items":{"type":"object","additionalProperties":true}},
    "artifacts":{"type":"array","items":{"type":"object","additionalProperties":true}}
  },
  "$defs":{
    "actor":{"type":"object","additionalProperties":true,"required":["kind","id"],"properties":{"kind":{"type":"string","minLength":1},"id":{"type":"string","minLength":1},"provider":{"type":["string","null"]},"model":{"type":["string","null"]},"runtime":{"type":["string","null"]}}},
    "step":{
      "type":"object",
      "additionalProperties":true,
      "required":["stepId","sequence","name","status","plannedAt","actor"],
      "properties":{
        "stepId":{"type":"string","pattern":"^STEP-[A-Za-z0-9._-]+$"},
        "executionId":{"type":"string","pattern":"^EXE-[A-Za-z0-9._-]+$"},
        "workItemId":{"type":"string","minLength":1},
        "sequence":{"type":"integer","minimum":1},
        "parentStepId":{"type":["string","null"],"pattern":"^STEP-[A-Za-z0-9._-]+$"},
        "name":{"type":"string","minLength":1},
        "description":{"type":["string","null"]},
        "classification":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "status":{"enum":["planned","active","completed","blocked","abandoned"]},
        "plannedAt":{"type":"string","format":"date-time"},
        "startedAt":{"type":["string","null"],"format":"date-time"},
        "completedAt":{"type":["string","null"],"format":"date-time"},
        "endedAt":{"type":["string","null"],"format":"date-time"},
        "actor":{"$ref":"#/$defs/actor"},
        "transitions":{"type":"array","items":{"type":"object","additionalProperties":true,"required":["sequence","to","timestamp"],"properties":{"sequence":{"type":"integer","minimum":1},"from":{"type":["string","null"]},"to":{"enum":["planned","active","completed","blocked","abandoned"]},"timestamp":{"type":"string","format":"date-time"}}}},
        "telemetry":{
          "type":"object",
          "additionalProperties":true,
          "properties":{
            "measurements":{
              "type":"array",
              "items":{
                "type":"object",
                "additionalProperties":true,
                "required":["measurementId","metricId","availability"],
                "properties":{
                  "measurementId":{"type":"string","minLength":1},
                  "metricId":{"type":"string","minLength":1},
                  "value":{"type":["number","null"],"minimum":0},
                  "unit":{"type":["string","null"]},
                  "currency":{"type":["string","null"]},
                  "quality":{"type":["string","null"]},
                  "confidence":{"oneOf":[{"type":"number","minimum":0,"maximum":1},{"enum":["low","medium","high"]},{"type":"null"}]},
                  "availability":{"enum":["measured","reported","calculated","estimated","unavailable","unsupported","unknown"]}
                }
              }
            },
            "rawTelemetry":{"type":"array","items":{"type":"object","additionalProperties":true}}
          }
        },
        "evidence":{"type":"array","items":{"type":"string"}}
      }
    }
  }
}
